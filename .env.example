# =====================================================
# CreativePulse AI — Environment Configuration Template
# =====================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env or frontend/.env.local to source control.
#
# Quick start:
#   cp .env.example backend/.env
#   # Then edit backend/.env with your real values
#
# Frontend:
#   echo "NEXT_PUBLIC_API_URL=http://localhost:8000" > frontend/.env.local

# =====================================================
# DATABASE
# =====================================================
# SQLite (development — no setup required):
DATABASE_URL=sqlite:///./creativepulse.db
#
# PostgreSQL (production — recommended):
# DATABASE_URL=postgresql://user:password@localhost:5432/creativepulse

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Generate a secure random secret (minimum 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =====================================================
# CORS
# =====================================================
FRONTEND_URL=http://localhost:3000

# =====================================================
# CLOUDINARY (optional — enables asset upload and repurposing)
# =====================================================
# Get these from https://cloudinary.com/console
# Leave blank to run without Cloudinary (performance-only mode).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================
# AI ASSISTANT (optional — deterministic mode works without this)
# =====================================================
# The assistant is data-grounded and works without any LLM.
# To enable an LLM layer, configure a compatible OpenAI-compatible endpoint.
OPENAI_API_BASE=
OPENAI_API_KEY=
AI_MODEL=

# =====================================================
# FRONTEND  (frontend/.env.local)
# =====================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
